local playerCardFrames = {}

local function updatePlayerList()
    for _, card in pairs(playerListContainer:GetChildren()) do
        if card:IsA("TextButton") then
            card:Destroy()
        end
    end
    playerCardFrames = {}

    local searchText = string.lower(searchBox.Text)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local playerName = string.lower(player.Name)
            local displayName = string.lower(player.DisplayName)

            if searchText == "" or string.find(playerName, searchText) or string.find(displayName, searchText) then
                local card = Instance.new("TextButton")
                card.Name = player.Name
                card.Size = UDim2.new(1, 0, 0, 45)
                card.BackgroundColor3 = (player == selectedPlayer) and Color3.fromRGB(45, 45, 65) or Color3.fromRGB(25, 25, 35)
                card.BackgroundTransparency = 0.3
                card.Text = ""
                card.AutoButtonColor = false
                card.Parent = playerListContainer

                local cardCorner = Instance.new("UICorner")
                cardCorner.CornerRadius = UDim.new(0, 8)
                cardCorner.Parent = card

                local cardStroke = Instance.new("UIStroke")
                cardStroke.Name = "Stroke"
                cardStroke.Color = (player == selectedPlayer) and Color3.fromRGB(80, 150, 255) or Color3.fromRGB(50, 50, 65)
                cardStroke.Thickness = 1
                cardStroke.Parent = card

                local pfp = Instance.new("ImageLabel")
                pfp.Name = "PFP"
                pfp.Size = UDim2.new(0, 35, 0, 35)
                pfp.Position = UDim2.new(0, 5, 0.5, -17.5)
                pfp.BackgroundTransparency = 1
                pfp.Image = "rbxasset://textures/ui/GuiImagePlaceholder.png"
                pfp.Parent = card

                local pfpCorner = Instance.new("UICorner")
                pfpCorner.CornerRadius = UDim.new(1, 0)
                pfpCorner.Parent = pfp

                task.spawn(function()
                    local success, content = pcall(function()
                        return Players:GetUserThumbnailAsync(player.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size150x150)
                    end)
                    if success and content then
                        pfp.Image = content
                    end
                end)

                local nameLabel = Instance.new("TextLabel")
                nameLabel.Name = "NameLabel"
                nameLabel.Size = UDim2.new(1, -50, 1, 0)
                nameLabel.Position = UDim2.new(0, 48, 0, 0)
                nameLabel.BackgroundTransparency = 1
                nameLabel.Text = player.Name .. " (@" .. player.DisplayName .. ")"
                nameLabel.TextColor3 = Color3.fromRGB(230, 230, 240)
                nameLabel.Font = Enum.Font.GothamMedium
                nameLabel.TextSize = 13
                nameLabel.TextXAlignment = Enum.TextXAlignment.Left
                nameLabel.Parent = card

                card.MouseButton1Click:Connect(function()
                    selectedPlayer = player
                    for p, c in pairs(playerCardFrames) do
                        local stroke = c:FindFirstChild("Stroke")
                        if p == selectedPlayer then
                            c.BackgroundColor3 = Color3.fromRGB(45, 45, 65)
                            if stroke then stroke.Color = Color3.fromRGB(80, 150, 255) end
                        else
                            c.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
                            if stroke then stroke.Color = Color3.fromRGB(50, 50, 65) end
                        end
                    end
                end)

                playerCardFrames[player] = card
            end
        end
    end
end

