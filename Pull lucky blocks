local function flatDistance(a, b)
    local delta = a - b
    return Vector3.new(delta.X, 0, delta.Z).Magnitude
end

local function flatDirection(vector, fallback)
    local flat = Vector3.new(vector.X, 0, vector.Z)

    if flat.Magnitude < 0.05 then
        return fallback or Vector3.zero
    end

    return flat.Unit
end

local function getGuardianPart(guardian)
    if guardian:IsA("BasePart") then
        return guardian
    end

    if guardian:IsA("Model") then
        return guardian.PrimaryPart
            or guardian:FindFirstChild("HumanoidRootPart")
            or guardian:FindFirstChildWhichIsA("BasePart")
    end

    return nil
end

